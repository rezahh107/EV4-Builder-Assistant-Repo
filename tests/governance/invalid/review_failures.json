{
  "scenarios": [
    {
      "scenario_id": "missing_review_receipt",
      "overrides": {"review_receipt": null},
      "expected_diagnostics": ["GOV-SEQ-019_REVIEW_RECEIPT_MISSING"]
    },
    {
      "scenario_id": "missing_inspector_identity",
      "overrides": {"review_receipt": {"inspector_repository": null, "inspector_repository_id": null, "inspector_commit_sha": null, "protocol_version": null}},
      "expected_diagnostics": ["GOV-SEQ-020_INSPECTOR_IDENTITY_MISSING"]
    },
    {
      "scenario_id": "wrong_inspector_repository_id",
      "overrides": {"review_receipt": {"inspector_repository_id": 999}},
      "expected_diagnostics": ["GOV-SEQ-022_INSPECTOR_REPOSITORY_ID_MISMATCH"]
    },
    {
      "scenario_id": "unsupported_protocol_version",
      "overrides": {"review_receipt": {"protocol_version": "v1.9.0"}},
      "expected_diagnostics": ["GOV-SEQ-023_PROTOCOL_VERSION_UNSUPPORTED"]
    },
    {
      "scenario_id": "source_actor_mismatch",
      "overrides": {"source_author_login": "different-review-actor"},
      "expected_diagnostics": ["GOV-SEQ-024_REVIEWER_ACTOR_MISMATCH"]
    },
    {
      "scenario_id": "unverified_inspector_commit",
      "overrides": {"inspector_commit_evidence": null},
      "expected_diagnostics": ["GOV-SEQ-025_INSPECTOR_COMMIT_UNVERIFIED"]
    },
    {
      "scenario_id": "self_authored_reviewer_actor",
      "overrides": {"source_author_login": "rezahh107", "review_receipt": {"reviewer_actor_login": "rezahh107"}},
      "expected_diagnostics": ["GOV-SEQ-026_SELF_AUTHORED_REVIEWER"]
    },
    {
      "scenario_id": "self_authored_review_context",
      "overrides": {"review_receipt": {"reviewer_context_id": "repo-maintainer-gov-003-004"}},
      "expected_diagnostics": ["GOV-SEQ-007_REVIEW_NOT_INDEPENDENT"]
    },
    {
      "scenario_id": "review_head_mismatch",
      "overrides": {"review_receipt": {"reviewed_head_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}},
      "expected_diagnostics": ["GOV-SEQ-008_REVIEW_HEAD_MISMATCH_OR_STALE"]
    },
    {
      "scenario_id": "review_scope_revision_mismatch",
      "overrides": {"review_receipt": {"scope_revision": "GOV-004-v2"}},
      "expected_diagnostics": ["GOV-SEQ-009_REVIEW_SCOPE_REVISION_MISMATCH_OR_STALE"]
    },
    {
      "scenario_id": "stale_after_head_change",
      "overrides": {
        "current": {"head_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
        "ci": {"head_sha": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"},
        "completion": {"implementation_commit": "bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"}
      },
      "expected_diagnostics": ["GOV-SEQ-008_REVIEW_HEAD_MISMATCH_OR_STALE"]
    }
  ]
}
