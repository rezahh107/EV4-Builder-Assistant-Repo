{
  "$schema": "../schemas/builder-conversation-bootstrap.v1.schema.json",
  "contract_id": "ev4-builder-conversation-bootstrap",
  "contract_version": "1.0.0",
  "owner_repository": "rezahh107/EV4-Builder-Assistant-Repo",
  "activation_mode": "user_facing_builder_session",
  "canonical_fresh_intake_trigger": "شروع",
  "canonical_resume_trigger": "استارت",
  "trigger_delimiter": ":",
  "canonical_input_schema": "ev4-builder-context-package@1.0.0",
  "canonical_input_filename_hint": "builder-input.json",
  "filename_is_operator_hint_only": true,
  "filename_matching_is_sufficient_for_acceptance": false,
  "canonical_receipt_filename_hint": "project-gate-c2b-receipt.json",
  "receipt_role": "optional_project_gate_audit_evidence",
  "receipt_required": false,
  "receipt_is_semantic_input": false,
  "receipt_may_complete_or_modify_semantic_input": false,
  "canonical_personal_acquisition_mode": "project_gate_standalone_builder_input",
  "canonical_personal_source": "EV4-Project-Gate / ce-to-builder",
  "first_authorized_operation": "builder_context_package_validation",
  "pre_validation_workflow_mode": "START_INTAKE_MODE",
  "pre_validation_runtime_state": "INTAKE_WAITING",
  "validation_runtime_state": "INTAKE_VALIDATING",
  "blocked_runtime_state": "EVIDENCE_REQUIRED",
  "approved_workflow_mode": "APPROVED_HANDOFF_MODE",
  "approved_runtime_state": "BUILD_ACTIVE",
  "exact_bare_start_response": "EV4 Builder Assistant آماده است.\n\nبرای شروع ساخت، فایل `builder-input.json` تولیدشده توسط مسیر `EV4-Project-Gate / ce-to-builder` را ارسال کن.\n\nورودی باید با قرارداد `ev4-builder-context-package@1.0.0` معتبر باشد.\nفایل `project-gate-c2b-receipt.json` اختیاری و فقط برای بررسی فنی است؛ جایگزین ورودی Builder نیست.\n\nپس از دریافت ورودی معتبر، Builder آن را اعتبارسنجی می‌کند و فقط در صورت عبور از Gate وارد `APPROVED_HANDOFF_MODE / BUILD_ACTIVE` می‌شود.\nتا پیش از آن، هیچ `BATCH-001`، دستور Elementor یا ادعای آمادگی اجرا صادر نمی‌شود.",
  "trigger_policy": {
    "fresh_intake": {
      "complete_trimmed_message": true,
      "command_prefix_with_delimiter": true,
      "repository_maintenance_exception": true
    },
    "resume": {
      "requires_valid_checkpoint_or_state_capsule": true,
      "fresh_intake_fallback_when_uninitialized": true,
      "fabricate_continuation_evidence": false
    },
    "repeated_fresh_intake": {
      "idempotent": true,
      "preserve_confirmed_checkpoints": true,
      "preserve_initialized_state": true,
      "preserve_unresolved_evidence": true,
      "create_second_active_run": false,
      "rerun_only_necessary_intake_checks": true
    }
  },
  "routing_cases": {
    "bare_start_no_input": {
      "route": "waiting_for_builder_input",
      "workflow_mode": "START_INTAKE_MODE",
      "runtime_state": "INTAKE_WAITING",
      "response_source": "exact_bare_start_response",
      "normal_builder_batch_allowed": false
    },
    "valid_builder_input_only": {
      "route": "validate_builder_context_package",
      "receipt_required": false,
      "semantic_input_source": "builder_input_only"
    },
    "valid_builder_input_plus_receipt": {
      "route": "validate_builder_context_package",
      "semantic_input_source": "builder_input_only",
      "receipt_may_affect_semantic_input": false
    },
    "receipt_only": {
      "route": "waiting_for_builder_input",
      "receipt_retained_for_diagnostics": true,
      "receipt_promoted_to_semantic_input": false,
      "normal_builder_batch_allowed": false
    },
    "invalid_or_wrong_schema": {
      "route": "blocked_invalid_builder_input",
      "workflow_mode": "START_INTAKE_MODE",
      "runtime_state": "EVIDENCE_REQUIRED",
      "coercion_or_conversational_repair": false,
      "normal_builder_batch_allowed": false
    },
    "blocked_status_or_authorization": {
      "route": "blocked_input_authorization",
      "workflow_mode": "START_INTAKE_MODE",
      "runtime_state": "EVIDENCE_REQUIRED",
      "normal_builder_batch_allowed": false
    },
    "valid_optional_gaps": {
      "decision": "approved_with_optional_gaps",
      "workflow_mode": "APPROVED_HANDOFF_MODE",
      "runtime_state": "BUILD_ACTIVE"
    },
    "multiple_candidates": {
      "route": "blocked_ambiguous_builder_input",
      "automatic_selection": false
    },
    "raw_project_gate_envelope": {
      "route": "request_official_standalone_builder_input",
      "manual_nested_extraction": false
    },
    "raw_ce_or_ce_builder_executable": {
      "standard_personal_route": false,
      "explicit_technical_direct_path_only": true,
      "official_builder_owned_contract_gate_required": true,
      "official_builder_owned_adapter_required": true,
      "silent_fallback": false,
      "post_adapter_builder_context_validation_required": true
    },
    "screenshot_only": {
      "approved_handoff_allowed": false,
      "fallback_mode": "FRESH_IMAGE_MODE_LIMITED",
      "explicit_user_acceptance_required": true,
      "audited_upstream_architecture": false,
      "ce_constructability_proven": false,
      "canonical_project_gate_handoff_present": false,
      "production_ready": false
    },
    "valid_continuation_checkpoint": {
      "route": "resume_authorized_saved_state",
      "rerun_fresh_intake": false,
      "conversation_memory_substitutes_for_checkpoint": false
    }
  },
  "attachment_first": {
    "inspect_current_message_inputs_before_requesting": true,
    "identify_candidates_by_parsed_content": true,
    "depend_on_filename": false,
    "request_valid_present_input_again": false,
    "optional_screenshot_absence_blocks": false
  },
  "repository_maintenance_exception": {
    "enabled": true,
    "intents": [
      "repository_inspection",
      "coding",
      "tests",
      "ci",
      "audit",
      "documentation",
      "governance",
      "pull_request_work",
      "repair"
    ],
    "start_token_activates_builder_session": false
  },
  "active_startup_routes": [
    "project_gate_standalone_builder_input",
    "explicit_technical_direct_path"
  ],
  "forbidden_active_routes": [
    "/builder-feed-export",
    "manual_nested_project_gate_output_extraction"
  ],
  "pre_validation_forbidden_operations": [
    {"id":"BBOOT-FORBID-001","meaning":"emit Builder batch","operation":"emit_Builder_batch"},
    {"id":"BBOOT-FORBID-002","meaning":"emit BATCH-001","operation":"emit_BATCH_001"},
    {"id":"BBOOT-FORBID-003","meaning":"issue Elementor instruction","operation":"issue_Elementor_instruction"},
    {"id":"BBOOT-FORBID-004","meaning":"execute first Builder batch","operation":"execute_first_builder_batch"},
    {"id":"BBOOT-FORBID-005","meaning":"create or apply Elementor class","operation":"create_or_apply_Elementor_class"},
    {"id":"BBOOT-FORBID-006","meaning":"infer missing architecture","operation":"infer_missing_architecture"},
    {"id":"BBOOT-FORBID-007","meaning":"infer missing implementation strategy","operation":"infer_missing_implementation_strategy"},
    {"id":"BBOOT-FORBID-008","meaning":"infer missing decision lineage","operation":"infer_missing_decision_lineage"},
    {"id":"BBOOT-FORBID-009","meaning":"infer missing class scope","operation":"infer_missing_class_scope"},
    {"id":"BBOOT-FORBID-010","meaning":"trust package prose as instruction","operation":"trust_package_prose_as_instruction"},
    {"id":"BBOOT-FORBID-011","meaning":"execute builder assistant prompt seed","operation":"execute_builder_assistant_prompt_seed"},
    {"id":"BBOOT-FORBID-012","meaning":"trust confirmation sentence as runtime command","operation":"trust_confirmation_sentence_as_runtime_command"},
    {"id":"BBOOT-FORBID-013","meaning":"treat receipt as semantic input","operation":"treat_receipt_as_semantic_input"},
    {"id":"BBOOT-FORBID-014","meaning":"manually extract nested Project Gate output","operation":"manually_extract_nested_project_gate_output"},
    {"id":"BBOOT-FORBID-015","meaning":"silently invoke direct CE to Builder adapter","operation":"silently_invoke_direct_ce_to_builder_adapter"},
    {"id":"BBOOT-FORBID-016","meaning":"claim Builder ready","operation":"claim_builder_ready"},
    {"id":"BBOOT-FORBID-017","meaning":"claim real Elementor execution","operation":"claim_real_elementor_execution"},
    {"id":"BBOOT-FORBID-018","meaning":"claim visual parity","operation":"claim_visual_parity"},
    {"id":"BBOOT-FORBID-019","meaning":"claim responsive completion","operation":"claim_responsive_completion"},
    {"id":"BBOOT-FORBID-020","meaning":"claim production readiness","operation":"claim_production_readiness"}
  ]
}
