{
  "schema": "ev4-builder-state-transitions@1.0.0",
  "workflow_modes": ["START_INTAKE_MODE", "APPROVED_HANDOFF_MODE", "FRESH_IMAGE_MODE_LIMITED"],
  "runtime_states": ["INTAKE_WAITING", "INTAKE_VALIDATING", "BUILD_ACTIVE", "WAITING_FOR_CONFIRMATION", "EVIDENCE_REQUIRED", "CORRECTION", "REVIEW_ONLY", "PAUSED", "COMPLETED"],
  "allowed_combinations": {
    "START_INTAKE_MODE": ["INTAKE_WAITING", "INTAKE_VALIDATING", "EVIDENCE_REQUIRED", "REVIEW_ONLY", "CORRECTION", "PAUSED"],
    "APPROVED_HANDOFF_MODE": ["BUILD_ACTIVE", "WAITING_FOR_CONFIRMATION", "EVIDENCE_REQUIRED", "CORRECTION", "REVIEW_ONLY", "PAUSED", "COMPLETED"],
    "FRESH_IMAGE_MODE_LIMITED": ["INTAKE_WAITING", "EVIDENCE_REQUIRED", "BUILD_ACTIVE", "WAITING_FOR_CONFIRMATION", "CORRECTION", "REVIEW_ONLY", "PAUSED"]
  },
  "transitions": [
    {
      "id": "fresh-intake",
      "from": null,
      "trigger": "شروع",
      "guards": ["no_initialized_session"],
      "to": {"workflow_mode": "START_INTAKE_MODE", "runtime_state": "INTAKE_WAITING"}
    },
    {
      "id": "repeated-start",
      "from": "ANY_INITIALIZED_STATE",
      "trigger": "شروع",
      "guards": ["preserve_session_id", "preserve_checkpoint", "preserve_unresolved_blockers"],
      "to": "SAME_STATE"
    },
    {
      "id": "intake-validate",
      "from": {"workflow_mode": "START_INTAKE_MODE", "runtime_state": "INTAKE_WAITING"},
      "trigger": "builder_input_received",
      "guards": ["candidate_is_unambiguous"],
      "to": {"workflow_mode": "START_INTAKE_MODE", "runtime_state": "INTAKE_VALIDATING"}
    },
    {
      "id": "intake-accepted",
      "from": {"workflow_mode": "START_INTAKE_MODE", "runtime_state": "INTAKE_VALIDATING"},
      "trigger": "intake_accepted",
      "guards": ["schema_valid", "semantic_valid", "lineage_valid", "input_authorization_valid"],
      "to": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"}
    },
    {
      "id": "intake-blocked",
      "from": {"workflow_mode": "START_INTAKE_MODE", "runtime_state": "INTAKE_VALIDATING"},
      "trigger": "intake_blocked",
      "guards": ["blocking_diagnostic_present"],
      "to": {"workflow_mode": "START_INTAKE_MODE", "runtime_state": "EVIDENCE_REQUIRED"}
    },
    {
      "id": "real-intake",
      "from": null,
      "trigger": "explicit_operator_source_selected",
      "guards": [
        "source_mode_arguments_exact",
        "selected_source_bytes_read",
        "internal_source_snapshot_created",
        "source_mode_derivation_valid",
        "builder_schema_valid",
        "builder_semantic_valid",
        "decision_lineage_valid",
        "runtime_context_derived",
        "initial_session_derived",
        "initial_checkpoint_derived",
        "checkpoint_sequence_initial",
        "generated_run_bundle_valid",
        "atomic_publication_required"
      ],
      "to": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"}
    },
    {
      "id": "pause",
      "from": "ANY_INITIALIZED_NON_COMPLETED_STATE",
      "trigger": "توقف",
      "guards": ["session_exists", "resumable_state_recorded"],
      "to": {"workflow_mode": "SAME", "runtime_state": "PAUSED"}
    },
    {
      "id": "resume",
      "from": {"workflow_mode": "ANY", "runtime_state": "PAUSED"},
      "trigger": "استارت",
      "guards": [
        "builder_input_verified",
        "intake_capsule_verified",
        "prior_initialized_state_exists",
        "session_id_matches",
        "package_digest_matches",
        "candidate_matches",
        "checkpoint_valid",
        "checkpoint_and_state_consistent",
        "unresolved_blockers_preserved",
        "resume_target_legal"
      ],
      "to": "PREVIOUS_RESUMABLE_STATE"
    },
    {
      "id": "emit-batch",
      "from": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"},
      "trigger": "action_batch_emitted",
      "guards": [
        "run_manifest_valid",
        "internal_source_snapshot_hash_matches",
        "full_runtime_context_rederivation_matches",
        "session_checkpoint_identity_matches",
        "checkpoint_sequence_valid",
        "batch_matches_context",
        "confirmed_action_ids_empty",
        "unconfirmed_action_ids_complete",
        "active_blocker_set_empty",
        "derived_waiting_carriers",
        "atomic_publication_required"
      ],
      "to": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "WAITING_FOR_CONFIRMATION"}
    },
    {
      "id": "confirm-batch",
      "from": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "WAITING_FOR_CONFIRMATION"},
      "trigger": "confirmation_accepted",
      "guards": [
        "run_manifest_valid",
        "internal_source_snapshot_hash_matches",
        "stored_context_digest_valid",
        "emit_result_binding_matches",
        "session_checkpoint_identity_matches",
        "checkpoint_sequence_valid",
        "batch_matches_context",
        "confirmed_action_ids_empty",
        "unconfirmed_action_ids_complete",
        "exact_operator_token_matches",
        "active_blocker_set_empty",
        "derived_build_active_carriers",
        "receipt_binds_resulting_checkpoint",
        "atomic_publication_required"
      ],
      "to": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"}
    },
    {
      "id": "attach-evidence",
      "from": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"},
      "trigger": "verified_evidence_attached",
      "guards": [
        "run_manifest_valid",
        "confirmation_exists",
        "external_evidence_bytes_read_once",
        "evidence_source_status_verified",
        "evidence_schema_valid",
        "evidence_semantic_binding_valid",
        "action_specific_execution_binding_valid",
        "internal_evidence_snapshot_created",
        "checkpoint_sequence_valid",
        "atomic_publication_required"
      ],
      "to": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"}
    },
    {
      "id": "enter-correction",
      "from": "ANY_INITIALIZED_NON_COMPLETED_STATE",
      "trigger": "blocking_error",
      "guards": ["repair_packet_created_or_updated"],
      "to": {"workflow_mode": "SAME", "runtime_state": "CORRECTION"}
    },
    {
      "id": "complete-builder",
      "from": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "BUILD_ACTIVE"},
      "trigger": "completion_validation_passed",
      "guards": [
        "builder_input_verified",
        "intake_capsule_verified",
        "predecessor_checkpoint_valid",
        "package_digest_matches",
        "candidate_matches",
        "session_id_matches",
        "checkpoint_sequence_valid",
        "required_actions_reconciled",
        "unresolved_blocking_evidence_count_zero",
        "completion_status_valid",
        "completion_gate_bound"
      ],
      "to": {"workflow_mode": "APPROVED_HANDOFF_MODE", "runtime_state": "COMPLETED"}
    }
  ],
  "forbidden": [
    "fresh_intake_to_completed",
    "fresh_image_to_completed",
    "completion_report_request_to_completed",
    "resume_without_prior_initialized_state",
    "start_command_fabricates_run",
    "unresolved_blocker_disappears",
    "intake_or_correction_direct_jump_to_completed",
    "caller_authored_completed_carrier_as_transition_input",
    "capsule_only_resume_or_completion_authorization",
    "required_action_disappears_by_omission",
    "confirm_batch_from_build_active",
    "confirm_batch_from_preconfirmed_carrier",
    "confirm_batch_with_incomplete_or_foreign_unconfirmed_actions",
    "evidence_without_verified_source_status",
    "generic_subject_authorizes_action_execution",
    "completion_batch_drift",
    "caller_authored_initial_state",
    "caller_managed_carrier_selection",
    "external_source_dependency_after_intake",
    "legacy_real_authority_entrypoint",
    "partial_intake_publication",
    "partial_emit_publication",
    "partial_confirmation_publication",
    "partial_evidence_publication",
    "partial_completion_publication"
  ]
}
