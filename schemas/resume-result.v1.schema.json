{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/resume-result.v1.schema.json","title":"EV4 Builder Resume Result","type":"object","required":["schema","status","transaction_id","resumed_from","resumed_to","checkpoint_sequence","unresolved_blockers_preserved"],"properties":{"schema":{"const":"ev4-builder-resume-result@1.0.0"},"status":{"const":"accepted"},"transaction_id":{"type":"string","pattern":"^[a-f0-9]{64}$"},"resumed_from":{"type":"object","required":["workflow_mode","runtime_state"],"properties":{"workflow_mode":{"type":"string","minLength":1},"runtime_state":{"const":"PAUSED"}},"additionalProperties":false},"resumed_to":{"type":"object","required":["workflow_mode","runtime_state"],"properties":{"workflow_mode":{"type":"string","minLength":1},"runtime_state":{"type":"string","not":{"const":"COMPLETED"}}},"additionalProperties":false},"checkpoint_sequence":{"type":"integer","minimum":2},"unresolved_blockers_preserved":{"const":true}},"additionalProperties":false}
