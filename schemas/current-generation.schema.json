{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/current-generation.schema.json",
  "title": "EV4 Builder Atomic CURRENT Pointer",
  "type": "object",
  "required": [
    "schema",
    "run_id",
    "generation",
    "generation_ref",
    "manifest_digest",
    "context_digest",
    "checkpoint_id",
    "checkpoint_sequence",
    "runtime_state",
    "pointer_digest"
  ],
  "properties": {
    "schema": { "const": "ev4-builder-current-generation@1.0.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[a-f0-9]{20}$" },
    "generation": { "type": "integer", "minimum": 1, "maximum": 999999 },
    "generation_ref": { "type": "string", "pattern": "^generations/[0-9]{6}$" },
    "manifest_digest": { "$ref": "#/$defs/hash" },
    "context_digest": { "$ref": "#/$defs/hash" },
    "checkpoint_id": { "type": "string", "minLength": 1 },
    "checkpoint_sequence": { "type": "integer", "minimum": 1 },
    "runtime_state": { "enum": ["BUILD_ACTIVE", "WAITING_FOR_CONFIRMATION", "COMPLETED"] },
    "pointer_digest": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "additionalProperties": false
}
