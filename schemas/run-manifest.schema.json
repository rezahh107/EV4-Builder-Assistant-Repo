{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/run-manifest.schema.json",
  "title": "EV4 Builder Atomic Run Manifest",
  "type": "object",
  "required": [
    "schema", "run_id", "source_mode", "source_snapshot_ref", "source_snapshot_sha256",
    "receipt_snapshot_ref", "receipt_snapshot_sha256", "runtime_context_ref", "runtime_context_digest",
    "session_ref", "checkpoint_ref", "current_runtime_state", "current_checkpoint_id",
    "current_checkpoint_sequence", "canonical_package_digest", "selected_candidate_id", "active_batch_id",
    "active_emit_result_ref", "active_confirmation_receipt_ref", "active_confirmation_result_ref",
    "confirmed_checkpoint_id", "confirmed_checkpoint_sequence", "evidence_snapshot_refs",
    "evidence_attachment_result_refs", "completion_result_ref", "completion_status_ref", "completion_gate_ref",
    "manifest_digest"
  ],
  "properties": {
    "schema": { "const": "ev4-builder-run-manifest@1.0.0" },
    "run_id": { "type": "string", "pattern": "^RUN-[a-f0-9]{20}$" },
    "source_mode": { "enum": ["project-gate", "direct-ce", "manual-builder-input"] },
    "source_snapshot_ref": { "const": "source/selected-source.json" },
    "source_snapshot_sha256": { "$ref": "#/$defs/hash" },
    "receipt_snapshot_ref": { "type": ["string", "null"] },
    "receipt_snapshot_sha256": { "anyOf": [{ "$ref": "#/$defs/hash" }, { "type": "null" }] },
    "runtime_context_ref": { "const": "runtime-context.json" },
    "runtime_context_digest": { "$ref": "#/$defs/hash" },
    "session_ref": { "const": "session-state.json" },
    "checkpoint_ref": { "const": "checkpoint.json" },
    "current_runtime_state": { "enum": ["BUILD_ACTIVE", "WAITING_FOR_CONFIRMATION", "COMPLETED"] },
    "current_checkpoint_id": { "type": "string", "minLength": 1 },
    "current_checkpoint_sequence": { "type": "integer", "minimum": 1 },
    "canonical_package_digest": { "$ref": "#/$defs/hash" },
    "selected_candidate_id": { "type": "string", "minLength": 1 },
    "active_batch_id": { "type": "string", "minLength": 1 },
    "active_emit_result_ref": { "type": ["string", "null"] },
    "active_confirmation_receipt_ref": { "type": ["string", "null"] },
    "active_confirmation_result_ref": { "type": ["string", "null"] },
    "confirmed_checkpoint_id": { "type": ["string", "null"] },
    "confirmed_checkpoint_sequence": { "type": ["integer", "null"], "minimum": 1 },
    "evidence_snapshot_refs": { "type": "array", "items": { "type": "string", "pattern": "^evidence/EV-[a-f0-9]{20}\\.json$" }, "uniqueItems": true },
    "evidence_attachment_result_refs": { "type": "array", "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "completion_result_ref": { "type": ["string", "null"] },
    "completion_status_ref": { "type": ["string", "null"] },
    "completion_gate_ref": { "type": ["string", "null"] },
    "manifest_digest": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "allOf": [
    {
      "if": { "properties": { "source_mode": { "const": "project-gate" } }, "required": ["source_mode"] },
      "then": {
        "properties": {
          "receipt_snapshot_ref": { "const": "source/project-gate-receipt.json" },
          "receipt_snapshot_sha256": { "$ref": "#/$defs/hash" }
        }
      },
      "else": {
        "properties": {
          "receipt_snapshot_ref": { "type": "null" },
          "receipt_snapshot_sha256": { "type": "null" }
        }
      }
    }
  ],
  "additionalProperties": false
}
