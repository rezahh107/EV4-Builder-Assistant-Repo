{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/builder-intake-result.v1.schema.json",
  "title": "EV4 Builder Lightweight Intake Result",
  "type": "object",
  "required": [
    "schema",
    "status",
    "source_file_sha256",
    "canonical_package_digest",
    "selected_candidate_id",
    "builder_context_schema",
    "blocking_diagnostics",
    "warnings",
    "source_file_unchanged",
    "publication"
  ],
  "properties": {
    "schema": { "const": "ev4-builder-intake-result@1.0.0" },
    "status": { "enum": ["accepted", "blocked"] },
    "source_file_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "canonical_package_digest": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
    "selected_candidate_id": { "type": ["string", "null"] },
    "builder_context_schema": { "type": ["string", "null"] },
    "blocking_diagnostics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": { "type": "string", "minLength": 1 },
          "message": { "type": "string", "minLength": 1 },
          "detail": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "source_file_unchanged": { "const": true },
    "publication": {
      "type": "object",
      "required": ["atomic", "output_path"],
      "properties": {
        "atomic": { "const": true },
        "output_path": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "accepted" } }, "required": ["status"] },
      "then": {
        "properties": {
          "canonical_package_digest": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "selected_candidate_id": { "type": "string", "minLength": 1 },
          "builder_context_schema": { "const": "ev4-builder-context-package@1.0.0" },
          "blocking_diagnostics": { "maxItems": 0 }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "blocked" } }, "required": ["status"] },
      "then": { "properties": { "blocking_diagnostics": { "minItems": 1 } } }
    }
  ],
  "additionalProperties": false
}
