{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EV4 Action Batch Contract",
  "description": "Lean personal runtime Action Batch. Ordinary actions carry execution-critical metadata only; extended rationale and reversibility fields are conditional for high-risk or difficult-to-reverse actions.",
  "type": "object",
  "required": [
    "schema",
    "selected_candidate_id",
    "approved_class_map",
    "max_normal_actions",
    "actions"
  ],
  "properties": {
    "schema": {
      "const": "ev4-action-batch@1.0.0"
    },
    "selected_candidate_id": {
      "type": "string",
      "minLength": 1
    },
    "approved_class_map": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "max_normal_actions": {
      "type": "integer",
      "minimum": 1
    },
    "allow_multiple_high_risk": {
      "type": "boolean"
    },
    "checkpointed": {
      "type": "boolean"
    },
    "evidence": {
      "type": "object"
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "action_id",
          "target_node",
          "element_type",
          "control_family",
          "control_name",
          "responsive_scope",
          "expected_result"
        ],
        "properties": {
          "action_id": { "type": "string", "minLength": 1 },
          "target_node": { "type": "string", "minLength": 1 },
          "element_type": { "type": "string", "minLength": 1 },
          "class_name": { "type": "string", "minLength": 1 },
          "class_scope": { "enum": ["Local Classes", "Global Classes"] },
          "class_operation": { "enum": ["none", "add", "remove", "preserve"] },
          "control_family": { "type": "string", "minLength": 1 },
          "control_name": { "type": "string", "minLength": 1 },
          "value": {},
          "value_source": { "type": "string", "minLength": 1 },
          "unit": { "type": "string", "minLength": 1 },
          "unit_policy_id": { "type": "string" },
          "responsive_scope": { "enum": ["desktop", "tablet", "mobile", "global"] },
          "risk_level": { "enum": ["low", "medium", "high"] },
          "difficult_to_reverse": { "type": "boolean" },
          "evidence_required": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "confirmation_scope": { "type": "string", "minLength": 1 },
          "allowed_class_source": { "enum": ["approved_class_map", "none"] },
          "forbidden_changes": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "rationale": { "type": "string", "minLength": 1 },
          "reversibility_analysis": { "type": "string", "minLength": 1 },
          "safety_decision": { "enum": ["proceed", "proceed_with_checkpoint", "block"] },
          "expected_result": { "type": "string", "minLength": 1 },
          "claims_responsive_behavior": { "type": "boolean" },
          "decision_lineage_ref": {
            "$ref": "#/$defs/decision_lineage_ref",
            "description": "Optional Kernel-governed decision lineage carried by actions that execute a locked upstream decision."
          }
        },
        "allOf": [
          {
            "if": { "required": ["class_name"] },
            "then": { "required": ["class_scope"] }
          },
          {
            "if": { "properties": { "value": { "type": "number" } }, "required": ["value"] },
            "then": { "required": ["unit", "value_source"] }
          },
          {
            "if": {
              "anyOf": [
                { "properties": { "risk_level": { "const": "high" } }, "required": ["risk_level"] },
                { "properties": { "difficult_to_reverse": { "const": true } }, "required": ["difficult_to_reverse"] }
              ]
            },
            "then": {
              "required": [
                "risk_level",
                "rationale",
                "reversibility_analysis",
                "safety_decision",
                "evidence_required",
                "confirmation_scope",
                "forbidden_changes"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "decision_lineage_ref": {
      "type": "object",
      "required": [
        "decision_family",
        "decision_card_ref",
        "selected_option",
        "rejected_options",
        "evidence_refs",
        "evidence_state",
        "consumer_stage"
      ],
      "properties": {
        "decision_family": { "type": "string", "minLength": 1 },
        "decision_card_ref": { "type": "string", "minLength": 1 },
        "selected_option": { "type": "string", "minLength": 1 },
        "rejected_options": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "evidence_state": { "enum": ["validated", "insufficient_evidence", "pending_correction"] },
        "consumer_stage": { "const": "builder" }
      },
      "additionalProperties": false
    }
  }
}
