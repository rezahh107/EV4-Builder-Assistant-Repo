{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/emit-batch-result.v2.schema.json",
  "title": "EV4 Builder Atomic Emit Batch Result",
  "type": "object",
  "required": ["schema", "run_id", "transition_id", "status", "source_snapshot_sha256", "context_digest", "package_digest", "selected_candidate_id", "batch_id", "action_ids", "action_digests", "predecessor_checkpoint", "resulting_checkpoint", "runtime_state", "builder_build_complete", "responsive_complete", "production_ready", "publication", "blocking_diagnostics"],
  "properties": {
    "schema": { "const": "ev4-builder-emit-batch-result@2.0.0" },
    "run_id": { "$ref": "#/$defs/run" },
    "transition_id": { "type": "string", "pattern": "^EMIT-[a-f0-9]{16}$" },
    "status": { "const": "accepted" },
    "source_snapshot_sha256": { "$ref": "#/$defs/hash" },
    "context_digest": { "$ref": "#/$defs/hash" },
    "package_digest": { "$ref": "#/$defs/hash" },
    "selected_candidate_id": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "action_ids": { "$ref": "#/$defs/actions" },
    "action_digests": { "$ref": "#/$defs/digests" },
    "predecessor_checkpoint": { "$ref": "#/$defs/predecessor" },
    "resulting_checkpoint": { "$ref": "#/$defs/resulting" },
    "runtime_state": { "const": "WAITING_FOR_CONFIRMATION" },
    "builder_build_complete": { "const": false },
    "responsive_complete": { "const": false },
    "production_ready": { "const": false },
    "publication": { "$ref": "#/$defs/publication" },
    "blocking_diagnostics": { "type": "array", "maxItems": 0 }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run": { "type": "string", "pattern": "^RUN-[a-f0-9]{20}$" },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "digests": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" } },
    "predecessor": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_sequence"],
      "properties": { "checkpoint_id": { "type": "string", "minLength": 1 }, "checkpoint_sequence": { "type": "integer", "minimum": 1 } },
      "additionalProperties": false
    },
    "resulting": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_sequence", "parent_checkpoint_id"],
      "properties": { "checkpoint_id": { "type": "string", "minLength": 1 }, "checkpoint_sequence": { "type": "integer", "minimum": 2 }, "parent_checkpoint_id": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    },
    "publication": {
      "type": "object",
      "required": ["atomic", "files"],
      "properties": { "atomic": { "const": true }, "files": { "type": "array", "minItems": 6, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
