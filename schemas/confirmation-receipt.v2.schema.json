{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/confirmation-receipt.v2.schema.json",
  "title": "EV4 Builder Run Confirmation Receipt",
  "type": "object",
  "required": ["schema", "run_id", "runtime_mode", "context_digest", "package_digest", "selected_candidate_id", "confirmation_id", "operator_token", "batch_id", "action_ids", "action_digests", "predecessor_checkpoint", "resulting_checkpoint", "receipt_digest"],
  "properties": {
    "schema": { "const": "ev4-builder-confirmation-receipt@2.0.0" },
    "run_id": { "$ref": "#/$defs/run" },
    "runtime_mode": { "const": "real-builder-run" },
    "context_digest": { "$ref": "#/$defs/hash" },
    "package_digest": { "$ref": "#/$defs/hash" },
    "selected_candidate_id": { "type": "string", "minLength": 1 },
    "confirmation_id": { "type": "string", "minLength": 1 },
    "operator_token": { "type": "string", "minLength": 1 },
    "batch_id": { "type": "string", "minLength": 1 },
    "action_ids": { "$ref": "#/$defs/actions" },
    "action_digests": { "$ref": "#/$defs/digests" },
    "predecessor_checkpoint": { "$ref": "#/$defs/predecessor" },
    "resulting_checkpoint": { "$ref": "#/$defs/resulting" },
    "receipt_digest": { "$ref": "#/$defs/hash" }
  },
  "$defs": {
    "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "run": { "type": "string", "pattern": "^RUN-[a-f0-9]{20}$" },
    "actions": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 }, "uniqueItems": true },
    "digests": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/hash" } },
    "predecessor": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_sequence"],
      "properties": { "checkpoint_id": { "type": "string", "minLength": 1 }, "checkpoint_sequence": { "type": "integer", "minimum": 2 } },
      "additionalProperties": false
    },
    "resulting": {
      "type": "object",
      "required": ["checkpoint_id", "checkpoint_sequence", "parent_checkpoint_id"],
      "properties": { "checkpoint_id": { "type": "string", "minLength": 1 }, "checkpoint_sequence": { "type": "integer", "minimum": 3 }, "parent_checkpoint_id": { "type": "string", "minLength": 1 } },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
