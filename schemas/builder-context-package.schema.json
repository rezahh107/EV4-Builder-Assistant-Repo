{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/rezahh107/EV4-Builder-Assistant-Repo/schemas/builder-context-package.schema.json",
  "title": "EV4 Builder Context Package",
  "type": "object",
  "required": ["schema", "source_stage", "source_handoff_stage", "package_status", "selected_candidate_id", "selected_candidate_locked", "production_ready_allowed", "source_payload_ledger", "approved_structure_tree", "class_creation_application_map", "widget_mapping_table", "editable_content_map", "decoration_only_map", "asset_replacement_map", "scoped_css_need_map", "responsive_qa_seed", "forbidden_work", "first_builder_batch"],
  "properties": {
    "schema": { "const": "ev4-builder-context-package@1.0.0" },
    "source_stage": { "const": "/builder-feed-export" },
    "source_handoff_stage": { "const": "/handoff-export" },
    "package_status": { "enum": ["ready", "ready_with_visible_flags", "blocked"] },
    "selected_candidate_id": { "type": "string" },
    "selected_candidate_locked": { "const": true },
    "production_ready_allowed": { "const": false },
    "source_payload_ledger": { "type": "array" },
    "approved_structure_tree": { "type": "array" },
    "class_creation_application_map": { "type": "array" },
    "widget_mapping_table": { "type": "array" },
    "editable_content_map": { "type": "array" },
    "decoration_only_map": { "type": "array" },
    "asset_replacement_map": { "type": "array" },
    "scoped_css_need_map": { "type": "array" },
    "responsive_qa_seed": { "type": "object" },
    "forbidden_work": { "type": "array" },
    "first_builder_batch": { "type": "object" },
    "confirmation_request": { "type": "object" },
    "confirmation_sentence": { "type": "string" },
    "display_only_untrusted_text": { "type": "object" },
    "task_type": { "type": "string" },
