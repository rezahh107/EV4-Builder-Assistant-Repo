    "build_intent_brief": { "type": "object" },
    "spatial_lexicon_version_used": { "type": "string" },
    "visual_tolerance_policy": { "type": "object" },
    "ce_to_builder_field_preservation_manifest": { "type": "object" },
    "input_authorization": { "type": "object" }
