    "visual_parity_expected": { "type": "boolean" },
    "reference_artifact_type": { "type": "string" },
    "reference_screenshot_instruction": { "type": "object" },
    "reference_paradigm_lock": { "type": "object" },
    "paradigm_to_structure_map": { "type": "object" },
    "first_batch_structure_intent": { "type": "object" },
    "audit_flags_to_preserve": { "type": "array" },
