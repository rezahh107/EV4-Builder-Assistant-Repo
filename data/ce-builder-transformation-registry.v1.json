    {"id":"NO_SILENT_TRANSFORMS","severity":"blocker","text":"Every CE to Builder transform used by adapter code must have a mapping entry in this registry."},
    {"id":"NO_UNDECLARED_DATA_LOSS","severity":"blocker","text":"A source field may be omitted from Builder output only when this registry explicitly marks it retained_in_ir_only or covered_by_projection."},
    {"id":"NODE_MODEL_COMPACT_ID","severity":"blocker","text":"CE connector_layer {node, model} must project to Builder connector_layer as exactly node:model with no inserted whitespace."},
